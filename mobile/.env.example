# Backend URL for the target device. Use the emulator host for local development
# or the owner-supplied HTTPS API URL in production.
API_BASE_URL=
ENVIRONMENT=development

# Public Firebase application configuration from the project owner's Firebase app.
# These are not service-account credentials.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# OAuth client IDs from the Firebase/Google Cloud project; required for Google login.
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=
