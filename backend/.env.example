# Runtime environment
ENVIRONMENT=development
# Use only exact HTTPS frontend origins for staging/production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL connection string supplied by the project owner.
# Keep the actual URL in the ignored backend/.env file; do not commit it.
DATABASE_URL=
# Optional owner-managed DDL-capable URL used only by Alembic; omit from app runtime.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Firebase Authentication. Use ADC locally or inject the service-account JSON
# from a secret manager into the backend process only.
FIREBASE_PROJECT_ID=
FIREBASE_CHECK_REVOKED=true
FIREBASE_SERVICE_ACCOUNT_JSON=

# Background Tasks & Redis Cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# GenAI Integrations
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
