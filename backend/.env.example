# Application Environment
ENVIRONMENT=development
ALLOW_DEV_TOKENS=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://cipherpage.com

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://cipheruser:cipherpassword@localhost:5432/cipherpagedb

# Authentication (Supabase JWT Secret & API)
JWT_SECRET=your-jwt-secret-min-32-chars
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_PROJECT_REF=your-project-ref

# Background Tasks & Redis Cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# GenAI Integrations (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
